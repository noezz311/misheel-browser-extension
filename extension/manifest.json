{
  "manifest_version": 3,
  "name": "Мишээл — Солонгос толь",
  "version": "1.2.2",
  "description": "Солонгос текст сонгоход монгол утга гарна. PDF автоматаар нээж, тодруулах, үзгээр зурах, текст нэмэх, хадгалах боломжтой.",
  "minimum_chrome_version": "125",
  "permissions": ["storage", "activeTab", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Мишээл толь",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https: http: file:; base-uri 'none'"
  }
}
